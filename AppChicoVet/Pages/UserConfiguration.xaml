<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppChicoVet.Pages.UserConfiguration"
             Title="UserConfiguration">

    <ScrollView>
        <VerticalStackLayout
       Padding="20"
       Spacing="10">

            <Label
           x:Name="lblVoltar"
           HorizontalTextAlignment="Center"
           Text="↩"
           FontAttributes="Bold"
           Margin="0, -40, 0, 0"
           TranslationX="-225"
           TranslationY="30"
           FontSize="20"
           TextColor="#513635">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ChangingPageUser"/>
                </Label.GestureRecognizers>

            </Label>

            <Image 
           Aspect="AspectFit" 
           Source="appicon.png"
           HeightRequest="125"
           WidthRequest="125"/>

            <Label
           x:Name="lblTitle"
           HorizontalTextAlignment="Center"
           Text="Configuração de usuário"
           Margin="0,-25,0,15"
           FontSize="35"
           TextColor="#513635"/>

            <Label 
         x:Name="lblNome"
         Text="Nome completo"
         WidthRequest="350"/>

            <Entry
         x:Name="etrNome"
         Placeholder=""
         WidthRequest="350"/>

            <Label 
         x:Name="lblSenha"
         Text="Senha"
         WidthRequest="350"/>

            <Entry
         x:Name="etrSenha"
         IsPassword="False"
         Placeholder=""
         WidthRequest="350"/>

            <Button
           x:Name="btnConcluir"
           Text="Confirmar"
           WidthRequest="250"
           TranslationY="50"
           Margin="0,0,0,50"
           BackgroundColor="#513635"
           Clicked="btnConcluir_Clicked"/>

            <Grid
            RowDefinitions="Auto,Auto"
            ColumnDefinitions="Auto,*"
            WidthRequest="350"
            Margin="0, 55, 0, 0">

                <Label
                 Grid.Row="0"
                 Grid.Column="1"
                 Text="ATENÇÃO: Ação irreversível"
                 TextColor="Gray"
                 TranslationX="45"/>

                <CheckBox
               x:Name="chkExcluirUser"
               Grid.Row="1"
               Grid.Column="0"
               Scale=".75"
               Color="DarkRed"
               TranslationX="115"/>

                <Label
                 Grid.Row="1"
                 Grid.Column="1"
                 Text="Excluir usuário"
                 TextColor="DarkRed"
                 TranslationY="11"
                 TranslationX="105"/>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>